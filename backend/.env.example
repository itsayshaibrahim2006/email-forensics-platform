# Copy this file to .env and adjust as needed

# PostgreSQL connection (used by docker-compose by default)
DATABASE_URL=postgresql+psycopg2://forensics_user:forensics_pass@db:5432/forensics_db

# If running the backend locally (outside docker) against dockerized Postgres, use:
# DATABASE_URL=postgresql+psycopg2://forensics_user:forensics_pass@localhost:5432/forensics_db

# Set to sqlite for zero-setup local testing instead of Postgres:
# DATABASE_URL=sqlite:///./forensics.db

# Free IP geolocation API (no key required, rate-limited). Swap for MaxMind/IPinfo in production.
GEO_API_URL=http://ip-api.com/json/{ip}

# CORS - frontend origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:5173

# Claude API key, used to generate investigator-facing risk narratives and
# thread summaries on top of the rule-based detection engine's findings.
# Get one at https://console.anthropic.com/ — leave blank to fall back to a
# plain rule-based summary string (the rest of the platform still works).
ANTHROPIC_API_KEY=HIDDEN
